# ==============================================================================
# ULTIMATE PLYMOUTH THEME FOR MAYANK ANAND
# "God-Tier" Show-off Edition - Neon Glow V3 (Bug-Free)
# ------------------------------------------------------------------------------
# Author: Mayank Anand
# Description: High-performance, cinematic boot splash with neon aesthetics, 
#              dynamic particle physics, and state-aware progress tracking.
# ==============================================================================

# --- WINDOW & ENVIRONMENT SETUP ---
# Initialize the primary display environment and background canvas.
Window.SetBackgroundTopColor (0, 0, 0);
Window.SetBackgroundBottomColor (0, 0, 0);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# --- GLOBAL ENGINE STATE ---
# Track system lifecycle and animation timing.
state = "startup"; # Lifecycle: startup -> password -> booting -> quit
time = 0;          # Global monotonic clock
alpha = 0;         # Global master opacity
progress_alpha = 0; # Isolated opacity for progress elements

# --- STAGE ASSETS: ATMOSPHERIC EFFECTS ---
# Vignette: Adds cinematic depth to the screen edges.
vignette.image = Image("vignette.png").Scale(screen_width, screen_height);
vignette.sprite = Sprite(vignette.image);
vignette.sprite.SetOpacity(0.5);

# Ambient Glow: Provides a subtle neon aura behind the main logo.
ambient.image = Image("ambient_glow.png");
ambient.sprite = Sprite(ambient.image);
ambient.sprite.SetX(screen_width / 2 - ambient.image.GetWidth() / 2);
ambient.sprite.SetY(screen_height / 3 - ambient.image.GetHeight() / 2);
ambient.sprite.SetOpacity(0);

# Particle System: Procedurally generated floating "stars" for background motion.
particle_count = 30; 
for (i = 0; i < particle_count; i++) {
  if (i % 2 == 0) p_img = Image("particle_green.png");
  else p_img = Image("particle_maroon.png");
  
  particles[i].sprite = Sprite(p_img);
  particles[i].x = Math.Random() * screen_width;
  particles[i].y = Math.Random() * screen_height;
  particles[i].v = 0.2 + Math.Random() * 1.0; # Velocity
  particles[i].a = 0.1 + Math.Random() * 0.4; # Base Alpha
  particles[i].sprite.SetX(particles[i].x);
  particles[i].sprite.SetY(particles[i].y);
}

# --- STAGE ASSETS: CORE BRANDING ---
# Primary Logo: Centered high-resolution branding asset.
logo.original_image = Image("logo.png");
logo.sprite = Sprite(logo.original_image);
logo.x = screen_width / 2 - logo.original_image.GetWidth() / 2;
logo.y = screen_height / 3 - logo.original_image.GetHeight() / 2;
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);
logo.sprite.SetOpacity(0);

# Logo Reflection: Mirror effect for a polished, glass-like finish.
reflection.image = Image("logo_reflection.png");
reflection.sprite = Sprite(reflection.image);
reflection.sprite.SetX(logo.x);
reflection.sprite.SetY(logo.y + logo.original_image.GetHeight() + 5);
reflection.sprite.SetOpacity(0);

# NixOS Branding: Bottom-aligned secondary branding.
nixos.image = Image("nixos_bottom.png");
nixos.sprite = Sprite(nixos.image);
nixos.x = screen_width / 2 - nixos.image.GetWidth() / 2;
nixos.y = screen_height - nixos.image.GetHeight() - 40;
nixos.sprite.SetX(nixos.x);
nixos.sprite.SetY(nixos.y);
nixos.sprite.SetOpacity(0);

# --- STAGE ASSETS: PROGRESS TRACKING ---
# Progress Background: The track for the neon progress bar.
progress_bg.image = Image("progress_bg.n.png");
progress_bg.sprite = Sprite(progress_bg.image);
progress_bg.x = screen_width / 2 - progress_bg.image.GetWidth() / 2;
progress_bg.y = logo.y + logo.original_image.GetHeight() + 80; # Moved slightly up for better balance
progress_bg.sprite.SetX(progress_bg.x);
progress_bg.sprite.SetY(progress_bg.y);
progress_bg.sprite.SetOpacity(0);

# Progress Bar: The active fill element with dynamic scaling.
progress_bar.image = Image("progress_bar.n.png");
progress_bar.sprite = Sprite(progress_bar.image);
# Center the bar relative to the background. 
# The bar image (416x28) is larger than the bg (400x12) for the glow effect.
progress_bar.x_offset = (progress_bg.image.GetWidth() - progress_bar.image.GetWidth()) / 2;
progress_bar.y_offset = (progress_bg.image.GetHeight() - progress_bar.image.GetHeight()) / 2;
progress_bar.sprite.SetX(progress_bg.x + progress_bar.x_offset);
progress_bar.sprite.SetY(progress_bg.y + progress_bar.y_offset);
progress_bar.sprite.SetOpacity(0);

current_progress = 0;
fun progress_callback (duration, progress) {
  current_progress = progress;
  if (state == "booting" && progress > 0) {
    new_width = progress_bar.image.GetWidth() * progress;
    if (new_width < 1) new_width = 1;
    
    # Scale the bar
    scaled_bar = progress_bar.image.Scale(new_width, progress_bar.image.GetHeight());
    progress_bar.sprite.SetImage(scaled_bar);
    
    # Maintain X and Y offsets perfectly so the bar doesn't shift vertically or horizontally.
    # Left glow is 8px. To keep the solid bar perfectly aligned at progress_bg.x,
    # we dynamically offset the X coordinate by 8 * progress.
    glow_width = 8;
    progress_bar.sprite.SetX(progress_bg.x - (glow_width * progress));
    progress_bar.sprite.SetY(progress_bg.y + progress_bar.y_offset);
  }
}
Plymouth.SetBootProgressFunction(progress_callback);

# --- STAGE ASSETS: SECURITY & INPUT ---
# Lock Security Icon: Positioned LEFT of the input box for a sleek "Security Entry" look.
lock.image = Image("lock_maroon.png").Scale(40, 40);
lock.sprite = Sprite(lock.image);
lock.sprite.SetOpacity(0);

# Password Input Field: Clean, minimalist UI for LUKS/User entry.
input_box.image = Image("input_box.png");
input_box.sprite = Sprite(input_box.image);

# Centering both lock and input box together horizontally
total_width = lock.image.GetWidth() + 12 + input_box.image.GetWidth(); # 40 + 12 + 400 = 452
start_x = screen_width / 2 - total_width / 2;

lock.x = start_x;
lock.y = progress_bg.y + 60;
lock.sprite.SetX(lock.x);
lock.sprite.SetY(lock.y);

input_box.x = start_x + lock.image.GetWidth() + 12;
input_box.y = lock.y;
input_box.sprite.SetX(input_box.x);
input_box.sprite.SetY(input_box.y);
input_box.sprite.SetOpacity(0);

# Bullet (Asterisk) System: Centered password character feedback.
bullet.image = Image("bullet.png");
bullet_spacing = 26; # Solved overlap (bullet width is 20, spacing 26 gives 6px clear gap)
for (i = 0; i < 20; i++) {
  bullets[i].sprite = Sprite(bullet.image);
  bullets[i].sprite.SetOpacity(0);
}

fun display_password_callback (prompt, bullets_count) {
  state = "password";
  input_box.sprite.SetOpacity(1);
  lock.sprite.SetOpacity(1);
  
  # Calculate position for bullets centered in the box.
  total_width = (bullets_count - 1) * bullet_spacing;
  if (total_width < 0) total_width = 0;
  
  start_x = input_box.x + (input_box.image.GetWidth() / 2) - (total_width / 2);
  
  for (i = 0; i < 20; i++) {
    if (i < bullets_count) {
      bullets[i].sprite.SetX(start_x + (i * bullet_spacing));
      bullets[i].sprite.SetY(input_box.y + (input_box.image.GetHeight() / 2) - (bullet.image.GetHeight() / 2));
      bullets[i].sprite.SetOpacity(1);
    } else {
      bullets[i].sprite.SetOpacity(0);
    }
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback () {
  # Transition from password entry to final boot sequence.
  state = "booting";
  input_box.sprite.SetOpacity(0);
  lock.sprite.SetOpacity(0);
  for (i = 0; i < 20; i++) bullets[i].sprite.SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

# --- RENDERING ENGINE: ANIMATION LOOP ---
# The heart of the theme. Handles real-time updates and procedural animations.
fun refresh_callback () {
  time += 0.05;
  
  if (state != "quit") {
    # --- MASTER FADE-IN SEQUENCE ---
    if (alpha < 1) {
      alpha += 0.02;
      logo.sprite.SetOpacity(alpha);
      reflection.sprite.SetOpacity(alpha * 0.4);
      nixos.sprite.SetOpacity(alpha * 0.8);
      ambient.sprite.SetOpacity(alpha * 0.3);
    }
    
    # --- PROCEDURAL BACKGROUND MOTION ---
    for (i = 0; i < particle_count; i++) {
      particles[i].y -= particles[i].v;
      if (particles[i].y < -20) particles[i].y = screen_height + 20;
      particles[i].sprite.SetY(particles[i].y);
      particles[i].sprite.SetOpacity(alpha * particles[i].a * (0.4 + 0.6 * Math.Sin(time * 0.5 + i)));
    }

    # --- DYNAMIC ASSET TRANSFORMATIONS ---
    # Breathing Logo Effect: Subtle scaling for a living feel.
    scale_factor = 1.0 + 0.02 * Math.Sin(time * 0.6);
    new_logo = logo.original_image.Scale(logo.original_image.GetWidth() * scale_factor, logo.original_image.GetHeight() * scale_factor);
    logo.sprite.SetImage(new_logo);
    logo.sprite.SetX(screen_width / 2 - new_logo.GetWidth() / 2);
    logo.sprite.SetY(screen_height / 3 - new_logo.GetHeight() / 2);
    reflection.sprite.SetY(logo.sprite.GetY() + new_logo.GetHeight() + 5);

    # Sync Ambient Glow with Logo Breathing for a "Power Core" effect.
    # We mix Maroon and Green by varying the intensity and shifting the hue 
    # slightly with the pulse.
    ambient_pulse = 0.3 + 0.15 * Math.Sin(time * 0.6);
    ambient.sprite.SetOpacity(alpha * ambient_pulse);
    
    # Subtle color shift hint: the glow pulses between deep maroon and neon intensity
    # (Achieved by shifting alpha and sync with particles)
    if (state == "booting") {
      # Smoothly fade in progress elements post-authentication.
      if (progress_alpha < 1) progress_alpha += 0.05;
      progress_bg.sprite.SetOpacity(progress_alpha * 0.4);
      # Neon Pulsing Effect for the active progress bar.
      progress_bar.sprite.SetOpacity(progress_alpha * (0.7 + 0.3 * Math.Sin(time * 2)));
    }
    
    if (state == "password") {
      # Security Lock Pulsing: Subtle visual cue for active input.
      lock_opacity = 0.7 + 0.3 * Math.Sin(time * 3);
      lock.sprite.SetOpacity(lock_opacity);
    }

  } else {
    # --- CINEMATIC EXIT SEQUENCE ---
    # Rapid zoom and fade out for a high-impact transition to the OS.
    alpha -= 0.05;
    if (alpha > 0) {
      exit_scale = 1.0 + (1.0 - alpha) * 2;
      scaled_logo = logo.original_image.Scale(logo.original_image.GetWidth() * exit_scale, logo.original_image.GetHeight() * exit_scale);
      logo.sprite.SetImage(scaled_logo);
      logo.sprite.SetOpacity(alpha);
      logo.sprite.SetX(screen_width / 2 - scaled_logo.GetWidth() / 2);
      logo.sprite.SetY(screen_height / 3 - scaled_logo.GetHeight() / 2);
      
      nixos.sprite.SetOpacity(alpha);
      ambient.sprite.SetOpacity(alpha * 0.5);
      vignette.sprite.SetOpacity(alpha * 0.5);
      progress_bar.sprite.SetOpacity(alpha);
      progress_bg.sprite.SetOpacity(alpha * 0.4);
    }
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- LIFECYCLE HOOKS ---
fun quit_callback () { state = "quit"; }
Plymouth.SetQuitFunction(quit_callback);

# ==============================================================================
# END OF SCRIPT - GOD-TIER STATUS: ACTIVE
# ==============================================================================
