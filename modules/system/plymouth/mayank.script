# Ultimate Plymouth Theme for Mayank Anand
# "God-Tier" Show-off Edition - Neon Glow V2

# --- INITIALIZATION ---
Window.SetBackgroundTopColor (0, 0, 0);
Window.SetBackgroundBottomColor (0, 0, 0);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

# --- VIGNETTE ---
vignette.image = Image("vignette.png").Scale(screen_width, screen_height);
vignette.sprite = Sprite(vignette.image);
vignette.sprite.SetOpacity(0.5); # Slightly deeper vignette for style

# --- AMBIENT BACKGROUND GLOW ---
ambient.image = Image("ambient_glow.png");
ambient.sprite = Sprite(ambient.image);
ambient.sprite.SetX(screen_width / 2 - ambient.image.GetWidth() / 2);
ambient.sprite.SetY(screen_height / 3 - ambient.image.GetHeight() / 2);
ambient.sprite.SetOpacity(0);

# --- PARTICLES (Floating Background) ---
particle_count = 20; # More particles for better effect
for (i = 0; i < particle_count; i++) {
  if (i % 2 == 0) p_img = Image("particle_green.png");
  else p_img = Image("particle_maroon.png");
  
  particles[i].sprite = Sprite(p_img);
  particles[i].x = Math.Random() * screen_width;
  particles[i].y = Math.Random() * screen_height;
  particles[i].v = 0.4 + Math.Random() * 1.2;
  particles[i].a = 0.2 + Math.Random() * 0.4;
  particles[i].sprite.SetX(particles[i].x);
  particles[i].sprite.SetY(particles[i].y);
}

# --- LOGO & REFLECTION ---
logo.original_image = Image("logo.png");
logo.sprite = Sprite(logo.original_image);
logo.x = screen_width / 2 - logo.original_image.GetWidth() / 2;
logo.y = screen_height / 3 - logo.original_image.GetHeight() / 2;
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);
logo.sprite.SetOpacity(0);

reflection.image = Image("logo_reflection.png");
reflection.sprite = Sprite(reflection.image);
reflection.sprite.SetX(logo.x);
reflection.sprite.SetY(logo.y + logo.original_image.GetHeight() + 5);
reflection.sprite.SetOpacity(0);

# --- NIXOS BRANDING (BOTTOM) ---
nixos.image = Image("nixos_bottom.png");
nixos.sprite = Sprite(nixos.image);
nixos.x = screen_width / 2 - nixos.image.GetWidth() / 2;
nixos.y = screen_height - nixos.image.GetHeight() - 40;
nixos.sprite.SetX(nixos.x);
nixos.sprite.SetY(nixos.y);
nixos.sprite.SetOpacity(0);

# --- STYLISH NEON PROGRESS BAR ---
progress_bg.image = Image("progress_bg.n.png");
progress_bg.sprite = Sprite(progress_bg.image);
progress_bg.x = screen_width / 2 - progress_bg.image.GetWidth() / 2;
progress_bg.y = logo.y + logo.original_image.GetHeight() + 100;
progress_bg.sprite.SetX(progress_bg.x);
progress_bg.sprite.SetY(progress_bg.y);
progress_bg.sprite.SetOpacity(0);

progress_bar.image = Image("progress_bar.n.png");
progress_bar.sprite = Sprite(progress_bar.image);
progress_bar.sprite.SetX(progress_bg.x);
progress_bar.sprite.SetY(progress_bg.y);
progress_bar.sprite.SetOpacity(0);

fun progress_callback (duration, progress) {
  if (progress > 0) {
    # Scale width while keeping height for a smooth fill
    new_width = progress_bar.image.GetWidth() * progress;
    if (new_width < 1) new_width = 1;
    progress_bar.sprite.SetImage(progress_bar.image.Scale(new_width, progress_bar.image.GetHeight()));
  }
}
Plymouth.SetBootProgressFunction(progress_callback);

# --- PASSWORD INPUT ---
input_box.image = Image("input_box.png");
input_box.sprite = Sprite(input_box.image);
input_box.x = screen_width / 2 - input_box.image.GetWidth() / 2;
input_box.y = progress_bg.y + 70;
input_box.sprite.SetX(input_box.x);
input_box.sprite.SetY(input_box.y);
input_box.sprite.SetOpacity(0);

bullet.image = Image("bullet.png");
for (i = 0; i < 40; i++) {
  bullets[i].sprite = Sprite(bullet.image);
  bullets[i].sprite.SetX(input_box.x + 24 + (i * 12));
  bullets[i].sprite.SetY(input_box.y + input_box.image.GetHeight() / 2 - bullet.image.GetHeight() / 2);
  bullets[i].sprite.SetOpacity(0);
}

fun display_password_callback (prompt, bullets_count) {
  input_box.sprite.SetOpacity(1);
  for (i = 0; i < 40; i++) {
    if (i < bullets_count) bullets[i].sprite.SetOpacity(1);
    else bullets[i].sprite.SetOpacity(0);
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

# --- ANIMATION LOOP ---
time = 0;
alpha = 0;
quitting = 0;
quit_alpha = 1;

fun refresh_callback () {
  time += 0.05;
  
  if (quitting == 0) {
    # Universal Fade-in
    if (alpha < 1) {
      alpha += 0.01;
      logo.sprite.SetOpacity(alpha);
      reflection.sprite.SetOpacity(alpha * 0.5);
      nixos.sprite.SetOpacity(alpha * 0.9);
      progress_bg.sprite.SetOpacity(alpha * 0.4);
      progress_bar.sprite.SetOpacity(alpha);
    }
    
    # Particle movement (Cinematic floating stars)
    for (i = 0; i < particle_count; i++) {
      particles[i].y -= particles[i].v;
      if (particles[i].y < -20) particles[i].y = screen_height + 20;
      particles[i].sprite.SetY(particles[i].y);
      particles[i].sprite.SetOpacity(alpha * particles[i].a * (0.4 + 0.6 * Math.Sin(time * 0.5 + i)));
    }

    # Breathing Logo Effect
    scale_factor = 1.0 + 0.03 * Math.Sin(time * 0.8);
    new_logo = logo.original_image.Scale(logo.original_image.GetWidth() * scale_factor, logo.original_image.GetHeight() * scale_factor);
    logo.sprite.SetImage(new_logo);
    logo.sprite.SetX(screen_width / 2 - new_logo.GetWidth() / 2);
    logo.sprite.SetY(screen_height / 3 - new_logo.GetHeight() / 2);
    reflection.sprite.SetY(logo.sprite.GetY() + new_logo.GetHeight() + 5);

    # STYLISH PROGRESS GLOW (Pulsing Neon Effect)
    # This creates a "breathing" light from the bar itself
    p_glow = 0.6 + 0.4 * Math.Sin(time * 1.2);
    progress_bar.sprite.SetOpacity(p_glow * alpha);

    # Ambient Pulsing Glow
    ambient_alpha = 0.3 + 0.2 * Math.Sin(time * 0.7);
    ambient.sprite.SetOpacity(ambient_alpha * alpha);
  } else {
    # Epic Exit Sequence
    quit_alpha -= 0.04;
    if (quit_alpha > 0) {
      exit_scale = 1.0 + (1.0 - quit_alpha) * 1.5;
      scaled_logo = logo.original_image.Scale(logo.original_image.GetWidth() * exit_scale, logo.original_image.GetHeight() * exit_scale);
      logo.sprite.SetImage(scaled_logo);
      logo.sprite.SetOpacity(quit_alpha);
      logo.sprite.SetX(screen_width / 2 - scaled_logo.GetWidth() / 2);
      logo.sprite.SetY(screen_height / 3 - scaled_logo.GetHeight() / 2);
      
      nixos.sprite.SetOpacity(quit_alpha);
      ambient.sprite.SetOpacity(quit_alpha * 0.5);
      vignette.sprite.SetOpacity(quit_alpha * 0.5);
      reflection.sprite.SetOpacity(0);
      progress_bar.sprite.SetOpacity(quit_alpha);
      progress_bg.sprite.SetOpacity(quit_alpha * 0.4);
    }
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- QUIT ---
fun quit_callback () { quitting = 1; }
Plymouth.SetQuitFunction(quit_callback);
