# --- MAVEN SILICON VPN CREDENTIALS ---
vpn:
  maven-silicon:
    username: "your-vpn-username"
    password: "your-vpn-password"
    gateway: "vpn.maven-silicon.com"

# --- USER CREDENTIALS ---
users:
  root:
    password: "your-hashed-root-password-here" # Use 'mkpasswd -m sha-512'
  primary-user:
    password: "your-hashed-user-password-here" # Use 'mkpasswd -m sha-512'

# --- GITHUB / DEV TOKENS (EXAMPLE) ---
# github:
#   token: "your-github-token"
